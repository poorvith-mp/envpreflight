{
  "name": "envpreflight",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "pnpm --filter @envpreflight/docs build" },
  "assets": {
    "directory": "./docs/out",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "envpreflight.poorvithmp.com", "custom_domain": true }
  ]
}
