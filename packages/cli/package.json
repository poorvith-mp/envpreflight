{
  "name": "@envpreflight/cli",
  "version": "1.1.0",
  "description": "Check your machine can actually run this project — before you waste a day finding out it can't.",
  "type": "module",
  "author": "Poorvith M P",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/poorvith-mp/envpreflight.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "envpreflight": "./dist/bin.js",
    "envpreflight-cli": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@envpreflight/core": "workspace:*",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.8.0",
    "tsup": "^8.4.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
